<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_walkthrough"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/dq_ic_back"
                app:tint="@color/dq_text"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/change_password"
                android:textColor="@color/dq_text"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:ignore="VisualLintSystemUi" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:text="@string/label_current_password"
            android:textColor="@color/dq_muted"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="18dp"
            android:autofillHints="password"
            android:background="@drawable/dq_bg_card"
            android:elevation="2dp"
            android:hint="@string/hint_current_password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="14dp"
            android:textColor="@color/dq_text"
            android:textColorHint="#616161"
            android:textSize="15sp"
            tools:ignore="VisualLintTextFieldSize" />

        <TextView
            android:id="@+id/errCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="24dp"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:visibility="gone"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="18dp"
            android:text="@string/label_new_password"
            android:textColor="@color/dq_muted"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="18dp"
            android:autofillHints="newPassword"
            android:background="@drawable/dq_bg_card"
            android:elevation="2dp"
            android:hint="@string/hint_new_password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="14dp"
            android:textColor="@color/dq_text"
            android:textColorHint="#616161"
            android:textSize="15sp"
            tools:ignore="VisualLintTextFieldSize" />

        <TextView
            android:id="@+id/errNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="24dp"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:visibility="gone"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="18dp"
            android:text="@string/label_confirm_password"
            android:textColor="@color/dq_muted"
            android:textSize="13sp"/>

        <EditText
            android:id="@+id/etConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="18dp"
            android:autofillHints="newPassword"
            android:background="@drawable/dq_bg_card"
            android:elevation="2dp"
            android:hint="@string/hint_confirm_password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:padding="14dp"
            android:textColor="@color/dq_text"
            android:textColorHint="#616161"
            android:textSize="15sp"
            tools:ignore="VisualLintTextFieldSize" />

        <TextView
            android:id="@+id/errConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="24dp"
            android:textColor="#E53935"
            android:textSize="13sp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="18dp"
            android:backgroundTint="#2B3A8F"
            android:contentDescription="@string/cd_save_password"
            android:text="@string/change_password"
            android:textAllCaps="false"
            android:textColor="@color/dq_white"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:ignore="VisualLintButtonSize" />
    </LinearLayout>
</ScrollView>